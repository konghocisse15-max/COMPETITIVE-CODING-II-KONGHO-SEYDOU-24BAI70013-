#include <iostream>
#include <vector>
#include <cmath>
using namespace std;

int main() {
    vector<int> nums = {5, 8, 10, 20};
    int k = 2;

    bool found = false;

    for (int i = 0; i < nums.size(); i++) {
        for (int j = i + 1; j < nums.size(); j++) {
            if (abs(i - j) <= k) {
                found = true;
                break;
            }
        }
        if (found)
            break;
    }

    if (found)
        cout << "Index distance is within k";
    else
        cout << "No pair satisfies the condition";

    return 0;
}
