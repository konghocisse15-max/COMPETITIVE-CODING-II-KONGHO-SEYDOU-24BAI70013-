#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<int> nums = {1, 2, 3, 4};
    int n = nums.size();

    vector<int> answer(n, 1);

    for (int i = 1; i < n; i++) {
        answer[i] = answer[i - 1] * nums[i - 1];
    }

    for (int x : answer)
        cout << x << " ";

    return 0;
}

OUTPUT: 1 1 2 6
