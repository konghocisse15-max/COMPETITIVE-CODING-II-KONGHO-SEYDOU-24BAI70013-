class MyQueue {
private:
    stack<int> s;

public:
    MyQueue() {
    }

    void push(int x) {
        s.push(x);
    }

    int pop() {
        // Base case: only one element left
        if (s.size() == 1) {
            int front = s.top();
            s.pop();
            return front;
        }

        int temp = s.top();
        s.pop();

        int front = pop();

        s.push(temp);

        return front;
    }

    int peek() {
        // Base case: only one element left
        if (s.size() == 1) {
            return s.top();
        }

        int temp = s.top();
        s.pop();

        int front = peek();

        s.push(temp);

        return front;
    }

    bool empty() {
        return s.empty();
    }
};

