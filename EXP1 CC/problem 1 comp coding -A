#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<int> nums = {1, 2, 3, 1};

    bool found = false;

    for (int i = 0; i < nums.size(); i++) {
        for (int j = i + 1; j < nums.size(); j++) {
            if (nums[i] == nums[j]) {
                found = true;
                break;
            }
        }
        if (found)
            break;
    }

    if (found)
        cout << "Duplicate Found";
    else
        cout << "No Duplicate";

    return 0;
}
OUTPUT: DUPLICATE FOUND
